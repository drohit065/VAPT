# Copy to .env and fill in every value:  cp .env.example .env
# Never commit .env.

# --- Dashboard login (single admin user) ---
ADMIN_USERNAME=admin
# At least 12 characters.
ADMIN_PASSWORD=change-me-to-a-long-password

# --- Session signing key (at least 32 characters) ---
# Generate with:  openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=480

# --- Encryption key for Git access tokens while a scan is queued ---
# Generate with:  docker run --rm python:3.12-slim python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# --- PostgreSQL ---
POSTGRES_USER=vapt
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=vapt

# --- Web port published on the host ---
HTTP_PORT=80

# --- Limits ---
MAX_UPLOAD_MB=100
MAX_EXTRACT_MB=500
MAX_EXTRACT_FILES=20000
MAX_REPO_MB=1000
SCAN_TIMEOUT_SECONDS=3600

# --- AI review (optional) ---
# Leave ANTHROPIC_API_KEY empty to disable the AI review check.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OWASP ZAP (live URL scans) ---
# API key the worker uses to drive the ZAP container. Generate with:  openssl rand -hex 24
ZAP_API_KEY=replace-with-output-of-openssl-rand-hex-24
